{
  "paths": {
    "input": "input",
    "output": "output",
    "templates": "templates",
    "models": "models"
  },
  "ffmpeg": {
    "binary": "/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg",
    "ffprobe": "/opt/homebrew/opt/ffmpeg-full/bin/ffprobe"
  },
  "whisper": {
    "binary": "whisper-cli",
    "model": "models/ggml-large-v3-turbo-q5_0.bin",
    "defaultLanguage": "ur"
  },
  "audio": {
    "sampleRate": 16000,
    "channels": 1
  },
  "captions": {
    "maxWordsPerLine": 5,
    "maxLineDuration": 3.0,
    "maxGapSeconds": 0.6
  },
  "render": {
    "defaultTemplate": "clean"
  },
  "enhance": {
    "highpassHz": 90,
    "denoiseNf": -25,
    "loudnessI": -16,
    "loudnessTP": -1.5,
    "loudnessLRA": 11,
    "useAIDenoiser": false
  }
}
